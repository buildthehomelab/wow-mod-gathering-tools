[worldserver]

########################################
# mod-gathering-tools
#
# Mining and Skinning work without a Mining Pick or Skinning Knife in your bags. Carrying the
# tool (or anything that counts as one, like a Gnomish Army Knife) gives a skill bonus and faster
# gathering instead.
########################################

#
#    GatheringTools.NoToolRequired
#        Description: Mining and Skinning (every rank, and mining a creature's corpse) don't need
#                     the tool. The client checks the tool itself, so players also need the client
#                     patch (tools/patch-gathering-tools-dbc.py); without it the client still says
#                     "Requires Mining Pick". With 0, the tools are required again.
#        Default:     1
#

GatheringTools.NoToolRequired = 1

#
#    GatheringTools.ToolSkillBonus
#        Description: Mining or Skinning skill bonus while the matching tool is in your bags or
#                     equipped. It shows as a green bonus in the skill window and counts for which
#                     nodes and corpses you can gather, not for skill-ups. 0 turns the bonus off.
#        Default:     10
#

GatheringTools.ToolSkillBonus = 10

#
#    GatheringTools.ToolGatherSpeed
#        Description: How much faster (in percent) mining and skinning are while the matching tool
#                     is in your bags or equipped: 25 cuts the cast time by a quarter. 0 turns it
#                     off, 100 makes gathering instant.
#        Default:     25
#

GatheringTools.ToolGatherSpeed = 25

#
#    GatheringTools.UpdateInterval
#        Description: How often (in milliseconds) each player's tool bonus is checked against their
#                     bags. It's also checked right before every Mining or Skinning cast, so this
#                     only decides how soon the skill window shows a change.
#        Default:     2000
#

GatheringTools.UpdateInterval = 2000

#
#    GatheringTools.DiscardBotQuestLootOnBosses
#        Description: A corpse can only be skinned once nothing is left on it, including loot only
#                     other group members can see. Bots pass on quest items (Head of Onyxia),
#                     leave their own copy of per-player ones (Mature Black Dragon Sinew) and can
#                     win a unique item they already carry, so a boss killed with bots never
#                     becomes skinnable. With 1, once the players have taken all the loot they
#                     can from a skinnable boss, what is left is thrown away and the corpse
#                     becomes skinnable. A unique item a player already carries doesn't count as
#                     theirs. Nothing is thrown away while a roll is running, while gold is left,
#                     or while a player of the group is outside the instance. Groups of only bots
#                     are left alone.
#        Default:     1
#

GatheringTools.DiscardBotQuestLootOnBosses = 1
